{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // Exclude Node.js major updates from Renovate proposals.
      description: "Disable Node.js major updates",
      matchManagers: ["mise"],
      matchPackageNames: ["node"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      // Create separate PRs for Node.js patch and minor updates outside the toolchain group.
      // Manually approve minor updates in the Dependency Dashboard after checking patch updates, for example, after merging their PRs.
      description: "Separate Node.js patch and minor updates",
      matchManagers: ["mise"],
      matchPackageNames: ["node"],
      groupName: null,
      separateMinorPatch: true,
    },
  ],
}
