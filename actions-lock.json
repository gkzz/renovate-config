{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Keep action and reusable workflow refs readable while actions.lock records their commits.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action",
        "workflow"
      ],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^(\\.github/workflows/.*\\.ya?ml)$/"
      ],
      "matchStrings": [
        "gh extension install github/gh-actions-lock --pin (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
